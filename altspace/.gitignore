# Unity project of a port (portkit/template). One level up is the fork's own repository.
# Upstream Unity repositories often ignore every Assets/ folder (EmyChess does): this project's own is kept.
!/[Aa]ssets/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emory[Cc]aptures/
/[Rr]ecordings/
.utmp/
*.log

# Upstream assets and their data-only stand-in scripts: regenerated by portkit/tools/importer from the fork's own files.
/Assets/Upstream/
/Assets/Upstream.meta

# Built by the kit builder (PortKit/Kit/Build Bundles): never checked in.
/Assets/WebRoot/asset.world
/Assets/WebRoot/asset.world.meta
*.bundle
*.manifest

# The artifact folder (PortKit/Kit/Export Artifacts): what the hub project releases from; rebuilt, never checked in.
/dist/

# TextMesh Pro's essentials: imported by PortKit/Setup/Run SDK Setup
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta

# Visual Scripting's node database: generated by the SDK setup, about 57 MB
/Assets/Unity.VisualScripting.Generated/
/Assets/Unity.VisualScripting.Generated.meta

# TypeScript side
/ts/node_modules/
/ts/dist/

# IDE and solution files Unity regenerates
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity crash and build leftovers
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.pidb.meta
*.pdb.meta
*.mdb.meta
